<script is:inline>
(() => {
  const initReferenceMenu = () => {
    const toggle = document.querySelector('.menu, .menu-button');
    const nav = document.querySelector('#nav, #site-nav, .nav > nav, .header-inner > nav');
    if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;
    nav.classList.add('locksmith-reference-menu');
    if (!nav.id) nav.id = 'locksmith-menu';
    toggle.setAttribute('aria-controls', nav.id);
    if (!nav.querySelector('.locksmith-menu-head')) {
      const head = document.createElement('div');
      head.className = 'locksmith-menu-head';
      head.innerHTML = '<div><small>24/7 LOCKSMITH HELP</small><strong>How can we help?</strong></div><button type="button" class="locksmith-menu-close" aria-label="Close navigation menu"><i></i><i></i></button>';
      nav.prepend(head);
    }
    const setState = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      nav.classList.toggle('open', open);
      document.documentElement.classList.toggle('locksmith-menu-open', open);
    };
    const closeMenu = (restoreFocus = false) => { setState(false); if (restoreFocus) toggle.focus(); };
    nav.querySelector('.locksmith-menu-close')?.addEventListener('click', () => closeMenu(true));
    const emergency = nav.querySelector('.emergency-menu-call');
    if (emergency) emergency.setAttribute('aria-label', 'Emergency Request. Call ' + (emergency.querySelector('strong')?.textContent || 'now'));
    if (nav.dataset.referenceMenuReady === 'true') return;
    nav.dataset.referenceMenuReady = 'true';
    toggle.addEventListener('click', () => requestAnimationFrame(() => setState(nav.classList.contains('open'))));
    nav.addEventListener('click', (event) => { const link = event.target.closest('a'); if (link && !link.closest('.nav-submenu, .services-menu')) closeMenu(false); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && nav.classList.contains('open')) closeMenu(true); });
    matchMedia('(min-width:1101px)').addEventListener('change', (event) => { if (event.matches) closeMenu(false); });
  };
  document.addEventListener('astro:page-load', initReferenceMenu);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initReferenceMenu, {once:true}); else initReferenceMenu();
})();
</script>

