<div class="a11y-toolbar" data-a11y-menu>
  <button class="a11y-trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="a11y-panel" aria-label="Open accessibility settings">
    <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
      <circle class="a11y-universal-ring" cx="24" cy="24" r="20"></circle>
      <circle class="a11y-universal-head" cx="24" cy="13" r="3.2"></circle>
      <path d="M13.5 19.5c3.4 1.7 6.9 2.5 10.5 2.5s7.1-.8 10.5-2.5M24 19v10M24 27l-7 10M24 27l7 10"></path>
    </svg>
  </button>

  <dialog class="a11y-panel" id="a11y-panel" role="dialog" aria-modal="true" aria-labelledby="a11y-title">
    <header>
      <div><span>Display preferences</span><h2 id="a11y-title">Accessibility settings</h2></div>
      <button class="a11y-close" type="button" aria-label="Close accessibility settings">×</button>
    </header>
    <p class="a11y-intro">Adjust this website for a more comfortable reading experience.</p>
    <div class="a11y-options" role="group" aria-label="Accessibility options">
      <button type="button" data-a11y-feature="largeText" aria-pressed="false"><span class="a11y-option-icon" aria-hidden="true">A+</span><span><strong>Bigger text</strong><small>Increase text size across the site</small></span><i aria-hidden="true"></i></button>
      <button type="button" data-a11y-feature="highContrast" aria-pressed="false"><span class="a11y-option-icon contrast-icon" aria-hidden="true">◐</span><span><strong>High contrast</strong><small>Strengthen light and dark separation</small></span><i aria-hidden="true"></i></button>
      <button type="button" data-a11y-feature="readableFont" aria-pressed="false"><span class="a11y-option-icon" aria-hidden="true">Aa</span><span><strong>Legible font</strong><small>Use a clear system typeface</small></span><i aria-hidden="true"></i></button>
      <button type="button" data-a11y-feature="highlightLinks" aria-pressed="false"><span class="a11y-option-icon" aria-hidden="true">↗</span><span><strong>Highlight links</strong><small>Underline and mark every link</small></span><i aria-hidden="true"></i></button>
      <button type="button" data-a11y-feature="reduceMotion" aria-pressed="false"><span class="a11y-option-icon" aria-hidden="true">Ⅱ</span><span><strong>Pause animations</strong><small>Stop motion and transitions</small></span><i aria-hidden="true"></i></button>
    </div>
    <button class="a11y-reset" type="button">Reset all settings</button>
    <p class="a11y-status" aria-live="polite" aria-atomic="true"></p>
  </dialog>
</div>

<script is:inline>
(() => {
  const KEY = 'a11y-preferences';
  const FEATURES = {
    largeText: 'a11y-large-text',
    highContrast: 'a11y-high-contrast',
    readableFont: 'a11y-readable-font',
    highlightLinks: 'a11y-highlight-links',
    reduceMotion: 'a11y-reduce-motion'
  };
  const read = () => {
    try {
      const value = JSON.parse(localStorage.getItem(KEY) || '{}');
      return value && typeof value === 'object' ? value : {};
    } catch {
      return {};
    }
  };
  const apply = (state) => {
    Object.entries(FEATURES).forEach(([key, className]) => {
      document.documentElement.classList.toggle(className, state[key] === true);
    });
  };
  const save = (state) => {
    try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {}
  };

  window.__initAccessibilityMenu = () => {
    apply(read());
    document.querySelectorAll('[data-a11y-menu]').forEach((root) => {
      const footer = document.querySelector('footer');
      if (footer && !footer.contains(root)) footer.appendChild(root);
      if (root.dataset.a11yReady === 'true') return;
      root.dataset.a11yReady = 'true';
      const trigger = root.querySelector('.a11y-trigger');
      const panel = root.querySelector('.a11y-panel');
      const close = root.querySelector('.a11y-close');
      const reset = root.querySelector('.a11y-reset');
      const status = root.querySelector('.a11y-status');
      const toggles = [...root.querySelectorAll('[data-a11y-feature]')];
      let lastFocus = null;

      const sync = () => {
        const state = read();
        toggles.forEach((button) => {
          button.setAttribute('aria-pressed', String(state[button.dataset.a11yFeature] === true));
        });
        apply(state);
      };
      const setStatus = (message) => {
        if (!status) return;
        status.textContent = '';
        requestAnimationFrame(() => { status.textContent = message; });
      };
      const setOpen = (open) => {
        if (!trigger || !panel) return;
        if (open && !panel.open) {
          lastFocus = document.activeElement;
          panel.showModal();
          trigger.setAttribute('aria-expanded', 'true');
          root.classList.add('is-open');
          (close || toggles[0])?.focus();
        } else if (!open && panel.open) {
          panel.close();
        }
      };

      trigger?.addEventListener('click', () => setOpen(trigger.getAttribute('aria-expanded') !== 'true'));
      close?.addEventListener('click', () => setOpen(false));
      panel?.addEventListener('cancel', (event) => {
        event.preventDefault();
        setOpen(false);
      });
      panel?.addEventListener('click', (event) => { if (event.target === panel) setOpen(false); });
      panel?.addEventListener('close', () => {
        trigger?.setAttribute('aria-expanded', 'false');
        root.classList.remove('is-open');
        (lastFocus instanceof HTMLElement ? lastFocus : trigger)?.focus();
      });
      toggles.forEach((button) => button.addEventListener('click', () => {
        const state = read();
        const key = button.dataset.a11yFeature;
        state[key] = state[key] !== true;
        save(state);
        sync();
        const label = button.querySelector('strong')?.textContent || 'Setting';
        setStatus(label + (state[key] ? ' enabled.' : ' disabled.'));
      }));
      reset?.addEventListener('click', () => {
        try { localStorage.removeItem(KEY); } catch {}
        apply({});
        sync();
        setStatus('All accessibility settings reset.');
      });
      sync();
    });
  };

  if (!window.__a11yGlobalListeners) {
    window.__a11yGlobalListeners = true;
    document.addEventListener('DOMContentLoaded', window.__initAccessibilityMenu);
    document.addEventListener('astro:page-load', window.__initAccessibilityMenu);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', window.__initAccessibilityMenu, { once: true });
  } else {
    window.__initAccessibilityMenu();
  }
})();
</script>

<script>
  // @ts-nocheck
  const initLocksmithNavigation = () => {
    const toggle = document.querySelector('.menu, .menu-button'); const nav = document.querySelector('#nav, #site-nav, .nav > nav, .header-inner > nav');
    if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;
    if (!toggle.querySelector('.hamburger-lines')) toggle.innerHTML = '<span class="hamburger-lines" aria-hidden="true"><i></i><i></i><i></i></span><span class="sr-only">Open navigation menu</span>';
    toggle.setAttribute('aria-label', toggle.getAttribute('aria-expanded') === 'true' ? 'Close navigation menu' : 'Open navigation menu');
    if (!nav.dataset.submenusReady) { nav.dataset.submenusReady='true'; const groups=[['/all-services/','Services',[['/all-services/','All services'],['/residential/','Residential'],['/commercial/','Commercial'],['/car-lockout/','Vehicle lockout']]],['/service-areas/','Areas',[['/service-areas/','All service areas'],['/contact/','Confirm an address']]],['/resources/','Resources',[['/resources/','Resource center'],['/guides/','Locksmith guides'],['/faq/','Frequently asked questions']]]]; groups.forEach(([href,label,items],index)=>{const anchor=[...nav.querySelectorAll(':scope > a')].find((a)=>a.getAttribute('href')===href);if(!anchor)return;const group=document.createElement('div');group.className='nav-group';const button=document.createElement('button');button.type='button';button.className='nav-group-trigger';button.setAttribute('aria-expanded','false');button.setAttribute('aria-controls',`nav-submenu-${index}`);button.innerHTML=`${label}<span aria-hidden="true">⌄</span>`;const menu=document.createElement('div');menu.className='nav-submenu';menu.id=`nav-submenu-${index}`;menu.hidden=true;items.forEach(([url,text])=>{const link=document.createElement('a');link.href=url;link.textContent=text;menu.appendChild(link)});group.append(button,menu);anchor.replaceWith(group);button.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')==='true';nav.querySelectorAll('.nav-group-trigger').forEach((other)=>{if(other!==button){other.setAttribute('aria-expanded','false');const panel=document.getElementById(other.getAttribute('aria-controls')||'');if(panel)panel.hidden=true}});button.setAttribute('aria-expanded',String(!open));menu.hidden=open})});document.addEventListener('keydown',(event)=>{if(event.key==='Escape')nav.querySelectorAll('.nav-group-trigger').forEach((button)=>{button.setAttribute('aria-expanded','false');const panel=document.getElementById(button.getAttribute('aria-controls')||'');if(panel)panel.hidden=true})}) }
    toggle.addEventListener('click',()=>requestAnimationFrame(()=>toggle.setAttribute('aria-label',toggle.getAttribute('aria-expanded')==='true'?'Close navigation menu':'Open navigation menu')),{once:true});
  }; document.addEventListener('astro:page-load',initLocksmithNavigation);if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initLocksmithNavigation,{once:true});else initLocksmithNavigation();
</script>

<style is:global>
  .a11y-toolbar{position:relative;z-index:150;display:inline-flex;margin-top:.8rem;font-family:Arial,Helvetica,sans-serif;line-height:1.4}
  .a11y-trigger{width:56px;height:56px;display:grid;place-items:center;padding:0;border:2px solid #eee;border-radius:50%;color:#ffd369;background:#222831;box-shadow:0 12px 34px rgba(34,40,49,.36);cursor:pointer}
  .a11y-trigger svg{width:30px;height:30px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
  .a11y-panel{position:fixed;inset:50% auto auto 50%;width:min(360px,calc(100vw - 28px));max-height:min(650px,calc(100vh - 40px));overflow:auto;margin:0;padding:0;border:1px solid rgba(57,62,70,.28);border-radius:18px;color:#222831;background:#eee;box-shadow:0 24px 75px rgba(34,40,49,.3);transform:translate(-50%,-50%)}
  .a11y-panel:not([open]){display:none!important}
  .a11y-panel::backdrop{background:rgba(0,41,107,.38);backdrop-filter:blur(2px)}
  .a11y-panel header{position:static!important;display:flex!important;justify-content:space-between;align-items:flex-start;gap:1rem;padding:1.15rem 1.15rem 1rem;color:#eee;background:#222831!important;box-shadow:none!important}
  .a11y-panel header span{display:block;margin-bottom:.2rem;color:#ffd369;font-size:.68rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
  .a11y-panel h2{margin:0!important;color:#eee!important;font:700 1.25rem/1.2 Arial,Helvetica,sans-serif!important;letter-spacing:0!important}
  .a11y-close{width:36px;height:36px;flex:0 0 auto;border:1px solid #eee;border-radius:50%;color:#eee;background:#393e46;font:400 1.5rem/1 Arial,sans-serif;cursor:pointer}
  .a11y-intro{margin:0;padding:1rem 1.15rem .8rem;color:#393e46;font-size:.88rem}
  .a11y-options{display:grid;padding:0 .8rem}
  .a11y-options>button{display:grid;grid-template-columns:42px minmax(0,1fr) 38px;align-items:center;gap:.7rem;min-height:68px;padding:.65rem .35rem;border:0;border-top:1px solid rgba(57,62,70,.2);color:#222831;background:#eee;text-align:left;cursor:pointer}
  .a11y-option-icon{width:38px;height:38px;display:grid;place-items:center;border-radius:10px;color:#eee;background:#393e46;font-weight:800}
  .contrast-icon{font-size:1.45rem}
  .a11y-options strong,.a11y-options small{display:block}
  .a11y-options strong{font-size:.92rem}.a11y-options small{margin-top:.15rem;color:#393e46;font-size:.75rem}
  .a11y-options i{position:relative;width:36px;height:20px;border-radius:999px;background:#393e46;transition:background .2s}
  .a11y-options i::after{content:"";position:absolute;top:3px;left:3px;width:14px;height:14px;border-radius:50%;background:#eee;box-shadow:0 1px 4px rgba(34,40,49,.3);transition:transform .2s}
  .a11y-options button[aria-pressed="true"] i{background:#ffd369}.a11y-options button[aria-pressed="true"] i::after{background:#222831;transform:translateX(16px)}
  .a11y-options button[aria-pressed="true"] .a11y-option-icon{color:#222831;background:#ffd369}
  .a11y-reset{width:calc(100% - 1.6rem);margin:.9rem .8rem .35rem;padding:.75rem;border:1px solid #393e46;border-radius:999px;color:#eee;background:#393e46;font-weight:800;cursor:pointer}
  .a11y-status{min-height:1.4rem;margin:.25rem 1rem .8rem;color:#393e46;font-size:.75rem;text-align:center}
  .a11y-trigger:focus-visible,.a11y-panel button:focus-visible{outline:3px solid #ffd369!important;outline-offset:3px}
  html.a11y-large-text{font-size:115%!important}
  html.a11y-high-contrast{--ink:#000!important;--paper:#fff!important;--white:#fff!important;--coral:#ffd500!important;--gold:#ffd500!important;--sage:#fff!important;--line:#000!important;--navy:#000!important;--blue:#000!important;--azure:#000!important;--yellow:#ffd500!important;background:#fff!important;color:#000!important}
  html.a11y-high-contrast body{color:#000!important;background:#fff!important}
  html.a11y-high-contrast :where(.notice,.dark,footer){color:#fff!important;background:#000!important}
  html.a11y-high-contrast :where(.notice,.dark,footer) :where(a,p,h1,h2,h3,span,strong){color:inherit!important}
  html.a11y-high-contrast :where(header,.request,.situation,.page-hero,input,select,textarea,.a11y-panel){color:#000!important;background:#fff!important;border-color:#000!important}
  html.a11y-high-contrast :where(a,button,input,select,textarea):focus-visible{outline:3px solid #ffd500!important;outline-offset:3px!important}
  html.a11y-readable-font *{font-family:Arial,Helvetica,sans-serif!important;letter-spacing:.05em!important;line-height:1.7!important}
  html.a11y-highlight-links a{text-decoration:underline 3px solid #f59e0b!important;text-underline-offset:4px!important;background-color:rgba(245,158,11,.15)!important}
  html.a11y-reduce-motion *,html.a11y-reduce-motion *::before,html.a11y-reduce-motion *::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
  .a11y-trigger{width:64px;height:64px}
  .a11y-trigger svg{width:42px;height:42px;stroke-width:2.5}
  .a11y-trigger .a11y-universal-head{fill:currentColor;stroke:none}
  @media(max-width:800px){.a11y-panel{width:calc(100vw - 28px);max-height:calc(100vh - 32px)}.a11y-trigger{width:48px;height:48px;border-width:1.5px}.a11y-trigger svg{width:30px;height:30px}}
  @media(prefers-reduced-motion:reduce){.a11y-options i,.a11y-options i::after{transition:none}}
  .menu,.menu-button{min-width:52px;min-height:52px;display:grid;place-items:center;padding:.65rem;border-radius:50%}.hamburger-lines{width:25px;display:grid;gap:5px}.hamburger-lines i{display:block;width:100%;height:2px;border-radius:2px;background:currentColor;transition:transform .2s,opacity .2s}.menu[aria-expanded="true"] .hamburger-lines i:nth-child(1),.menu-button[aria-expanded="true"] .hamburger-lines i:nth-child(1){transform:translateY(7px) rotate(45deg)}.menu[aria-expanded="true"] .hamburger-lines i:nth-child(2),.menu-button[aria-expanded="true"] .hamburger-lines i:nth-child(2){opacity:0}.menu[aria-expanded="true"] .hamburger-lines i:nth-child(3),.menu-button[aria-expanded="true"] .hamburger-lines i:nth-child(3){transform:translateY(-7px) rotate(-45deg)}.nav-group{position:relative}.nav-group-trigger{display:flex;align-items:center;gap:.35rem;border:0;color:inherit;background:transparent;font:inherit;font-weight:800;cursor:pointer}.nav-group-trigger span{transition:transform .2s}.nav-group-trigger[aria-expanded="true"] span{transform:rotate(180deg)}.nav-submenu{position:absolute;z-index:220;top:calc(100% + .7rem);left:0;min-width:240px;padding:.55rem;border:1px solid rgba(0,41,107,.18);border-radius:16px;background:#fff;box-shadow:0 20px 55px rgba(0,41,107,.18)}.nav-submenu[hidden]{display:none!important}.nav-submenu a{display:block!important;padding:.7rem .8rem!important;border-radius:10px;color:#00296b!important;white-space:nowrap}.nav-submenu a:hover,.nav-submenu a:focus-visible{background:#fff4bd;color:#00296b!important}@media(max-width:900px){.nav-group{width:100%}.nav-group-trigger{width:100%;justify-content:space-between;padding:.85rem 0}.nav-submenu{position:static;min-width:0;margin:.15rem 0 .65rem;padding:.35rem;box-shadow:none}.nav-submenu a{white-space:normal}}
</style>
