---
import BaseLayout from '../layouts/BaseLayout.astro';import ServiceGallery from './ServiceGallery.astro';import {site,services} from '../data/site';import {findLocation,mapSrc,type Location} from '../data/locations';const {location}=Astro.props as {location:Location};const nearby=location.nearby.map(findLocation).filter(Boolean);const schema=[{'@type':'Service',name:`Owner-operated locksmith service in ${location.name}`,description:`Daniel's Lock & Key service requests in ${location.name}.`,url:`${site.domain}/locations/${location.slug}/`,areaServed:{'@type':'City',name:location.name}}];
---
<BaseLayout title={`Locksmith ${location.name}, CA | Daniel's Lock & Key`} description={`Owner-operated locksmith service in ${location.name} for home lockouts, rekeying, lock repair, landlord turnovers, small businesses, and passenger-vehicle entry.`} canonical={`/locations/${location.slug}/`} {schema}><section class="local-hero"><div class="shell local-hero-grid"><div><nav class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/service-areas/">Service areas</a></nav><p class="kicker">Owner-operated mobile service</p><h1>Locksmith service in {location.name}, California</h1><p class="lede">Speak directly with Daniel about the exact location, affected opening, authorization, and desired result. Current availability and supported scope are confirmed before dispatch.</p><div class="actions"><a class="pill" href={`tel:${site.phoneHref}`}>Call Daniel · {site.phone}</a><a class="outline" href="/contact/">Request scheduled work</a></div></div><div class="map-card"><iframe src={mapSrc(location)} title={`OpenStreetMap of ${location.name}`} loading="lazy"></iframe><a href={`https://www.openstreetmap.org/?mlat=${location.lat}&mlon=${location.lon}#map=13/${location.lat}/${location.lon}`} target="_blank" rel="noopener">View on OpenStreetMap →</a></div></div></section><section class="section shell local-context"><div><p class="kicker">Local property context</p><h2>Start with the building and opening.</h2><p>{location.context}</p><p>Describe whether the request involves a house, apartment, condo, rental, office, storefront, common area, or supported passenger vehicle.</p></div><aside><h2>Prepare before calling</h2><ul class="check-list"><li>Exact {location.name} address or vehicle location</li><li>Door, lock, latch, or vehicle details</li><li>Photos for scheduled repair or rekeying requests</li><li>Proof of ownership, occupancy, management authority, or authorized use</li></ul></aside></section><section class="local-services"><div class="shell"><p class="kicker">Services in {location.name}</p><h2>Choose a locksmith request.</h2><div class="local-service-grid">{services.map(service=><a href={`/services/${service.slug}/`}><strong>{service.title}</strong><span>{service.short}</span><b>Explore service →</b></a>)}</div></div></section><ServiceGallery active={Astro.url.pathname}/><section class="section shell local-process"><div><p class="kicker">Daniel's call-first process</p><h2>Clear information before work begins</h2></div><ol><li><span>1</span><p>Confirm the exact {location.name} location and current coverage.</p></li><li><span>2</span><p>Verify the requester is authorized to access or change the property or vehicle.</p></li><li><span>3</span><p>Assess the installed hardware, door fit, or supported vehicle-entry need.</p></li><li><span>4</span><p>Discuss and approve the supported scope before work begins.</p></li></ol></section><section class="section shell local-faq"><div><h2>{location.name} locksmith FAQs</h2><p>Answers before you speak with Daniel.</p></div><div class="faq-list"><details><summary>Does Daniel serve {location.name}?</summary><p>{location.name} is a listed coverage community. Exact-address coverage and current availability are confirmed by phone.</p></details><details><summary>What authorization is required?</summary><p>Prepare identification and proof of ownership, occupancy, management authority, or authorized vehicle use.</p></details><details><summary>Can I request a guaranteed arrival time online?</summary><p>No. Daniel discusses the current schedule after confirming the location and service need.</p></details></div></section><section class="nearby"><div class="shell"><h2>Nearby Central Los Angeles service areas</h2><div>{nearby.map((x:any)=><a href={`/locations/${x.slug}/`}>{x.name}<span>Explore local page →</span></a>)}<a href="/service-areas/">All coverage areas<span>View hub →</span></a></div></div></section><section class="dark"><div class="shell call-band"><div><h2>Call Daniel for locksmith help in {location.name}.</h2><p>Share the location, opening type, and proof of authorized access.</p></div><a class="pill" href={`tel:${site.phoneHref}`}>Call {site.phone}</a></div></section></BaseLayout>
