---
import {site,services} from '../data/site';import {locations} from '../data/locations';const canonicalService:Record<string,string>={'home-lockout':'/house-lockout/','residential-rekeying':'/residential-rekeying/','lock-repair':'/lock-repair/','landlord-rekeying':'/landlord-rekeying/','commercial-lock-service':'/commercial-lockout/','car-lockout':'/car-lockout/'};
---
<section class="site-growth"><div class="shell growth-grid"><div><p class="kicker">More from Daniel's Lock & Key</p><h2>Owner-operated service, local coverage, and verified profiles.</h2><p>Choose a service or Central Los Angeles neighborhood, then call Daniel with the exact address.</p></div><div><h3>Locksmith services</h3>{services.slice(0,5).map(x=><a href={canonicalService[x.slug]}>{x.title}</a>)}</div><div><h3>Local pages</h3>{locations.slice(0,7).map(x=><a href={`/locations/${x.slug}/`}>{x.name}</a>)}<a href="/service-areas/"><strong>All areas →</strong></a></div></div><div class="shell social-strip"><strong>Connect with {site.name}</strong><div>{site.socials.map(x=><a href={x.url} target="_blank" rel="me noopener">{x.label}</a>)}</div></div></section>
