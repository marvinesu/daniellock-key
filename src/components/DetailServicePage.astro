---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { orderedMedia } from '../data/serviceMedia';
import type { DetailService } from '../data/serviceArchitecture';

const { service, pillar } = Astro.props as { service: DetailService; pillar: 'residential' | 'commercial' };
const hub = pillar === 'residential' ? '/residential/' : '/commercial/';
const heroMedia = orderedMedia(service.slug)[0];
const heroImage = `/images/services/${heroMedia.key}.webp`;
const heroImageSmall = `/images/services/${heroMedia.key}-sm.webp`;
---

<BaseLayout title={`${service.title} Hollywood | Daniel's Lock & Key`} description={service.description} canonical={`/${service.slug}/`}>
  <section class="page-hero">
    <div class="shell service-page-hero-grid">
      <div class="service-page-hero-copy">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={hub}>{pillar}</a><span>/</span><span>{service.title}</span></nav>
        <p class="kicker">{service.eyebrow}</p><h1>{service.title} in Hollywood</h1><p class="lede">{service.intro}</p>
        <div class="actions"><a class="pill" href={`tel:${site.phoneHref}`}>Call Daniel · {site.phone}</a><a class="outline" href="/contact/">Request scheduled work</a></div>
      </div>
      <figure class="service-page-hero-media">
        <picture><source media="(max-width: 720px)" srcset={heroImageSmall} /><img src={heroImage} width="1200" height="800" alt={heroMedia.alt} /></picture>
        <figcaption><span>{heroMedia.title}</span><small>Representative service scene</small></figcaption>
      </figure>
    </div>
  </section>
  <section class="section shell service-detail"><div><p class="kicker">Good fit for</p><h2>Start with the situation.</h2><ul class="check-list">{service.situations.map(item => <li>{item}</li>)}</ul><h2>What to have ready</h2><ul class="check-list"><li>Photo identification and proof of authorized access</li><li>The exact address and affected opening</li><li>Door and lock photos for scheduled work</li><li>Any landlord or building requirements</li></ul></div><aside><h2>Scope boundary</h2><p>{service.boundary}</p><p>Daniel confirms current coverage, availability, and scope by phone before dispatch.</p><a class="pill" href={`tel:${site.phoneHref}`}>Call Daniel</a></aside></section>
  <section class="section shell"><div class="heading"><p class="kicker">Keep exploring</p><h2>Related service paths</h2></div><div class="related-grid">{service.related.map(slug => <a href={`/${slug}/`}>{slug.replaceAll('-', ' ')} →</a>)}<a href={hub}>All {pillar} services →</a></div></section>
</BaseLayout>
