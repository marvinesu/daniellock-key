---
import {site,services} from '../data/site';
---
<form data-lead novalidate><input name="website" class="trap" tabindex="-1" autocomplete="off"><input type="hidden" name="page" data-page><div class="fields"><label>Name<input name="name" autocomplete="name" required></label><label>Phone<input name="phone" type="tel" autocomplete="tel" required></label><label>Service<select name="service" required><option value="">Choose one</option>{services.map(s=><option>{s.title}</option>)}</select></label><label>City or ZIP<input name="location" autocomplete="postal-code" required></label></div><label>What happened?<textarea name="details" rows="4" required></textarea></label><label class="consent"><input type="checkbox" name="consent" required><span>I agree to be contacted about this request. Do not send lock codes, passwords, payment data, or identity documents.</span></label><button class="pill" type="submit">Send request</button><p role="alert" data-status></p><small>For an active lockout, call <a href={`tel:${site.phoneHref}`}>{site.phone}</a>.</small></form>
<script>document.querySelectorAll<HTMLFormElement>('[data-lead]').forEach(form=>{const page=form.querySelector<HTMLInputElement>('[data-page]');if(page)page.value=location.href;form.addEventListener('submit',async event=>{event.preventDefault();const status=form.querySelector<HTMLElement>('[data-status]');if(!status)return;if(!form.checkValidity()){form.reportValidity();status.textContent='Please complete the required fields.';return}status.textContent='Sending…';const data:any=Object.fromEntries(new FormData(form));data.consent=Boolean(new FormData(form).get('consent'));try{const response=await fetch('/api/leads',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});const body=await response.json();if(!response.ok)throw new Error(body.error);status.textContent='Request received. We will review it and contact you if the service is available.';form.reset()}catch(error){status.textContent=`${error instanceof Error?error.message:'Unable to send.'} Please call.`}})})</script>
