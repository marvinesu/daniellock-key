---
import LeafletMap from './LeafletMap.astro';
import { locations } from '../data/locations';
const lat=locations.reduce((sum,x)=>sum+x.lat,0)/locations.length;
const lng=locations.reduce((sum,x)=>sum+x.lon,0)/locations.length;
---
<LeafletMap id="home-coverage-map" eyebrow="Interactive coverage map" title="Explore the listed service communities." description="Pins mark neighborhood centers for orientation, not storefronts or guaranteed dispatch points. Call with the exact address to confirm coverage." center={[lat,lng]} zoom={10} points={locations.map(({lat,lon,name})=>({lat,lng:lon,label:name,description:'Neighborhood-center reference. Exact-address coverage is confirmed by phone.'}))} compact actionHref="/service-areas/" actionLabel="View every service area" />
<aside class="home-location-summary"><strong>Business location</strong><h3>Hollywood mobile service area</h3><p>Daniel’s Lock & Key Service operates as an owner-operated mobile locksmith serving Hollywood and approved nearby Los Angeles neighborhoods. Call with the exact address to confirm coverage.</p><a href="/business-information/">View verified business information →</a></aside>
<style>.home-location-summary{margin-top:1rem;padding:1.2rem;border:1px solid rgba(0,41,107,.18);border-radius:16px;background:#fff}.home-location-summary strong{color:#d7192d;text-transform:uppercase;letter-spacing:.08em;font-size:.75rem}.home-location-summary h3{margin:.35rem 0}.home-location-summary p{margin:.4rem 0 1rem}</style>
