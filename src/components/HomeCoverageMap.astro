---
import LeafletMap from './LeafletMap.astro';
import { locations } from '../data/locations';
const lat=locations.reduce((sum,x)=>sum+x.lat,0)/locations.length;
const lng=locations.reduce((sum,x)=>sum+x.lon,0)/locations.length;
---
<LeafletMap id="home-coverage-map" eyebrow="Interactive coverage map" title="Explore the listed service communities." description="Pins mark neighborhood centers for orientation, not storefronts or guaranteed dispatch points. Call with the exact address to confirm coverage." center={[lat,lng]} zoom={10} points={locations.map(({lat,lon,name})=>({lat,lng:lon,label:name,description:'Neighborhood-center reference. Exact-address coverage is confirmed by phone.'}))} compact actionHref="/service-areas/" actionLabel="View every service area" />
