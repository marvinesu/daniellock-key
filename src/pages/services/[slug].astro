---
import BaseLayout from '../../layouts/BaseLayout.astro';import {site,services} from '../../data/site';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}))}const {service}=Astro.props;
---
<BaseLayout title={`${service.title} in Hollywood | ${site.name}`} description={`${service.short} Call to confirm exact-address coverage, current availability, authorization, and scope.`}><section class="page-hero"><div class="shell"><p class="kicker">{service.type} · Hollywood</p><h1>{service.title}</h1><p class="lede">{service.short}</p><a class="pill" href={`tel:${site.phoneHref}`}>Call Daniel · {site.phone}</a></div></section><section class="section shell detail"><div><h2>What this service includes</h2><p>{service.detail}</p><h2>Before you call</h2><ul><li>Prepare the exact service address or ZIP.</li><li>Describe the affected door, lock, or passenger vehicle.</li><li>Have proof of ownership, occupancy, or authorization ready.</li><li>Ask what the estimate includes and what could change it.</li></ul></div><aside><h2>Clear service limits</h2><p>The site does not publish guaranteed arrival times, starting prices, or unverified credentials.</p><p>Vehicle work is limited to passenger-vehicle lockout entry. No replacement keys, fobs, transponders, or ignition work.</p><a class="outline" href="/contact/">Request scheduled service</a></aside></section></BaseLayout>
