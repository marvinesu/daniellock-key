---
import BaseLayout from '../layouts/BaseLayout.astro';import {residentialDetails} from '../data/serviceArchitecture';import {site} from '../data/site';const icons=['door-open','apartment','key','house-lock','tools','lock','tools','shield-check','key'];
---
<BaseLayout title="Residential Locksmith Hollywood | Daniel's Lock & Key" description="Explore Hollywood house and apartment lockout, rekeying, repair, replacement, deadbolt, and broken-key services." canonical="/residential/"><section class="page-hero"><div class="shell narrow"><p class="kicker">Owner-operated residential help</p><h1>Choose the home-access problem Daniel can assess.</h1><p class="lede">Each page explains authorization, preparation, and practical service boundaries before you call.</p><div class="actions"><a class="pill" href={`tel:${site.phoneHref}`}>Call Daniel · {site.phone}</a><a class="outline" href="/contact/">Request scheduled work</a></div></div></section><section class="section shell"><div class="heading"><h2>Residential services by situation</h2><p>Lockout, rekeying, repair, and replacement solve different access problems.</p></div><div class="service-list">{residentialDetails.map((s,i)=><article data-reveal><i class={`fi fi-rr-${icons[i]} service-symbol`} aria-hidden="true"></i><div><p>{s.eyebrow}</p><h3>{s.title}</h3><p>{s.intro}</p></div><a href={`/${s.slug}/`}>Details →</a></article>)}</div></section></BaseLayout>
