---
import BaseLayout from '../layouts/BaseLayout.astro';import LeafletMap from '../components/LeafletMap.astro';import {site} from '../data/site';import {findLocation,locations} from '../data/locations';
---
<BaseLayout title="Hollywood Locksmith Service Areas | Daniel's Lock & Key" description="Service-area information for Hollywood and selected nearby Central Los Angeles communities."><section class="page-hero"><div class="shell"><p class="kicker">Exact-address confirmation</p><h1>Hollywood and selected nearby neighborhoods.</h1><p class="lede">A service area is not a storefront. Call with the exact address and requested work so coverage and current availability can be confirmed.</p></div></section><div class="section shell"><LeafletMap id="hollywood-coverage-map" eyebrow="Central Los Angeles coverage" title="Orient your call before service is confirmed." description="Pins show neighborhood centers for reference. They do not represent Daniel's storefronts or a promise that every address is currently covered." center={[34.078,-118.315]} zoom={11} points={locations.map(({lat,lon,name})=>({lat,lng:lon,label:name,description:'Neighborhood-center reference. Confirm the exact address by phone.'}))} radiusMeters={15000}/></div><section class="section shell area-cards">{site.areas.map((area,i)=>{const location=findLocation(area);return <article data-reveal><span>{String(i+1).padStart(2,'0')}</span><h2>{area}</h2><p>Lockout, rekeying, and repair requests are reviewed using the exact property location, installed hardware, and authorization.</p>{location&&<a href={`/locations/${location.slug}/`}>Explore {area} service →</a>}<a href={`tel:${site.phoneHref}`}>Call Daniel to confirm →</a></article>})}</section></BaseLayout>
