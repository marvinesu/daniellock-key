---
import BaseLayout from '../layouts/BaseLayout.astro';import {site} from '../data/site';
const schema=[{"@type":"Organization","@id":`${site.domain}/#organization`,name:site.name,url:site.domain,telephone:site.phoneHref,areaServed:site.areas.map(name=>({"@type":"City",name}))}];
---
<BaseLayout title={`Business Information | ${site.name}`} description={`Official business, phone, service-area, license, and locksmith service information for ${site.name}.`} {schema}><section class="page-hero"><div class="shell"><p class="kicker">Citation source of truth</p><h1>Business information</h1><p class="lede">Verified public identity and service information for Daniel's owner-operated mobile locksmith business.</p></div></section><section class="section shell facts"><div><h2>{site.name}</h2><dl><dt>Phone</dt><dd><a href={`tel:${site.phoneHref}`}>{site.phone}</a></dd><dt>Canonical website</dt><dd><a href={site.domain}>{site.domain}</a></dd><dt>Business type</dt><dd>Owner-operated mobile service-area business</dd><dt>Primary market</dt><dd>Hollywood and approved nearby Los Angeles communities</dd><dt>License</dt><dd>{site.license}</dd><dt>Public address</dt><dd>Street address is not published. This website does not represent a walk-in storefront.</dd></dl></div><aside><h2>Approved service areas</h2><ul>{site.areas.map(area=><li>{area}</li>)}</ul></aside></section><section class="section shell"><h2>Primary locksmith services</h2><div class="service-links"><a href="/house-lockout/">House lockout</a><a href="/residential-rekeying/">Residential rekeying</a><a href="/new-home-rekeying/">Move-in rekeying</a><a href="/lock-repair/">Residential lock repair</a><a href="/deadbolt-repair/">Deadbolt repair</a><a href="/commercial-rekeying/">Commercial rekeying</a><a href="/office-lock-repair/">Office lock repair</a><a href="/landlord-rekeying/">Property turnover</a><a href="/car-lockout/">Car lockout entry</a></div><p class="boundary">Vehicle work is limited to authorized passenger-vehicle entry. Replacement keys, cutting, programming, fobs, transponders, and ignition work are excluded.</p></section><section class="call-band-premium"><div class="shell"><div><p class="kicker">Speak directly with Daniel</p><h2>Confirm the location, lock, and next step.</h2></div><a class="pill" href={`tel:${site.phoneHref}`}>Call Daniel · {site.phone}</a></div></section></BaseLayout>
<style>.facts{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(2rem,6vw,6rem)}dl{display:grid;grid-template-columns:10rem 1fr;margin:0}dt,dd{padding:1rem 0;border-bottom:1px solid var(--line)}dt{font-weight:900}dd{margin:0}.facts aside,.boundary{padding:2rem;background:#fff8d5;border-left:5px solid #fdc500}.service-links{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);padding:1px;margin:2rem 0}.service-links a{padding:1.1rem;background:#fff;text-decoration:none;font-weight:900}@media(max-width:760px){.facts{grid-template-columns:1fr}dl{grid-template-columns:1fr}dt{padding-bottom:0;border:0}.service-links{grid-template-columns:1fr}}</style>
