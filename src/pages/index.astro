---
import BaseLayout from '../layouts/BaseLayout.astro';import LeadForm from '../components/LeadForm.astro';import {site,services,faqs} from '../data/site';const schema=[{"@type":"FAQPage",mainEntity:faqs.map(([q,a])=>({"@type":"Question",name:q,acceptedAnswer:{"@type":"Answer",text:a}}))}];
---
<BaseLayout title="Hollywood Locksmith | Daniel's Lock & Key" description="Owner-operated Hollywood locksmith help for home lockouts, residential rekeying, lock repair, selected commercial work, and passenger-vehicle lockout entry." {schema}>
<section class="hero"><div class="shell hero-grid"><div><p class="kicker">Hollywood · Owner-operated locksmith service</p><h1>Talk to Daniel.<br><em>Know the next step.</em></h1><p class="lede">Personal help for authorized home, rental, office, storefront, and passenger-vehicle lockouts—plus practical rekeying and lock repair.</p><div class="actions"><a class="pill" href={`tel:${site.phoneHref}`}>Call Daniel · {site.phone}</a><a class="outline" href="#request">Request scheduled work</a></div><small>Call to confirm exact-address coverage, current availability, and scheduling.</small></div><div class="hero-art" aria-label="Abstract key and doorway illustration"><div class="sun"></div><div class="door"><span></span></div><p>Clear questions. Practical options. Your approval before work begins.</p></div></div></section>
<section class="situation"><div class="shell"><p>Start with the problem</p><div><a href={`/services/${services[0].slug}/`}>Home lockout <span>→</span></a><a href={`/services/${services[1].slug}/`}>Need different keys <span>→</span></a><a href={`/services/${services[2].slug}/`}>Lock is not working <span>→</span></a><a href={`/services/${services[5].slug}/`}>Keys locked in car <span>→</span></a></div></div></section>
<section class="section shell" id="services"><div class="heading"><h2>A neighborhood locksmith, explained plainly.</h2><p>Daniel starts with the exact location, authorization, installed hardware, and what is actually happening at the door.</p></div><div class="service-list">{services.map((s,i)=><article data-reveal><span>{String(i+1).padStart(2,'0')}</span><div><p>{s.type}</p><h3>{s.title}</h3><p>{s.short}</p></div><a href={`/services/${s.slug}/`}>Learn more →</a></article>)}</div></section>
<section class="section blueprint-clusters"><div class="shell"><div class="heading"><h2>Rekey, repair or replace?</h2><p>Daniel's educational approach starts with the condition of the cylinder, latch, strike, door and existing hardware—not a predetermined product.</p></div><div class="blueprint-grid"><article><p class="kicker">Rekey</p><h3>Change who has a working key</h3><p>Best considered when compatible hardware is serviceable but old, missing or unreturned keys create an access change.</p><a href="/residential-rekeying/">Explore residential rekeying →</a></article><article><p class="kicker">Repair</p><h3>Diagnose the symptom first</h3><p>Sticking keys and binding bolts can involve the cylinder, latch, strike, hinges or door alignment.</p><a href="/lock-repair/">Explore repair options →</a></article><article><p class="kicker">Replace</p><h3>Use compatible new hardware when needed</h3><p>Replacement is considered when the existing lock is damaged, unreliable or unsuitable for the intended function.</p><a href="/lock-replacement/">Explore lock replacement →</a></article></div></div></section>
<section class="dark"><div class="shell process"><div><p class="kicker">Daniel's process</p><h2>Listen. Inspect. Explain.</h2><p>The site does not invent a price or arrival time. Daniel confirms the request by phone.</p></div><ol><li><span>1</span><div><h3>Explain the situation</h3><p>Share the exact address, affected opening, and whether you are currently locked out.</p></div></li><li><span>2</span><div><h3>Confirm access and hardware</h3><p>Have proof of authorization ready. Photos can help with scheduled repair and rekey requests.</p></div></li><li><span>3</span><div><h3>Approve the work</h3><p>Review the recommended method and estimate before authorizing service.</p></div></li></ol></div></section>
<section class="section shell areas"><div><p class="kicker">Local coverage</p><h2>Hollywood first. Nearby neighborhoods by address.</h2><p>Priority areas include {site.areas.join(', ')}. Call to confirm the exact property.</p><a class="outline" href="/service-areas/">Review service areas</a></div><div class="area-orbit" aria-hidden="true"><b>Hollywood</b>{site.areas.slice(1,5).map((area,i)=><span style={`--i:${i}`}>{area}</span>)}</div></section>
<section class="section shell faq"><div><p class="kicker">Before you call</p><h2>Direct answers from the service guide</h2></div><div>{faqs.slice(0,4).map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></section>
<section class="request" id="request"><div class="shell request-grid"><div><p class="kicker">Scheduled work</p><h2>Tell Daniel about the door and lock.</h2><p>For an active lockout, call. Use the form for rekeying, repairs, turnover work, and other scheduled requests.</p></div><LeadForm/></div></section>
</BaseLayout>
