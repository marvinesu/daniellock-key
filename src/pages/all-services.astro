---
import BaseLayout from '../layouts/BaseLayout.astro';import {residentialDetails,commercialDetails} from '../data/serviceArchitecture';import {site} from '../data/site';
---
<BaseLayout title="Locksmith Services Hollywood | Daniel's Lock & Key" description="Browse Daniel's residential, selected commercial, and passenger-vehicle lockout service paths in Hollywood." canonical="/all-services/"><section class="page-hero"><div class="shell narrow"><p class="kicker">Clear service paths</p><h1>Find the opening, lock, or access change you need.</h1><p class="lede">Daniel confirms the exact address, installed hardware, current coverage, and authorization before accepting work.</p><div class="actions"><a class="pill" href={`tel:${site.phoneHref}`}>Call Daniel</a><a class="outline" href="/resources/">Prepare first</a></div></div></section><section class="section shell"><div class="heading"><h2>Residential</h2><a href="/residential/">View residential hub →</a></div><div class="area-cards">{residentialDetails.map(s=><article><h3>{s.title}</h3><p>{s.description}</p><a href={`/${s.slug}/`}>Details →</a></article>)}</div></section><section class="section shell"><div class="heading"><h2>Selected commercial</h2><a href="/commercial/">View commercial hub →</a></div><div class="area-cards">{commercialDetails.map(s=><article><h3>{s.title}</h3><p>{s.description}</p><a href={`/${s.slug}/`}>Details →</a></article>)}</div></section><section class="section shell"><div class="heading"><h2>Passenger-vehicle entry</h2><p>Entry only—no replacement keys, fobs, programming, or ignition work.</p></div><a class="pill" href="/car-lockout/">View car lockout help</a></section></BaseLayout>
