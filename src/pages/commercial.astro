---
import BaseLayout from '../layouts/BaseLayout.astro';import {commercialDetails} from '../data/serviceArchitecture';import {site} from '../data/site';const icons=['door-open','key','store-alt','briefcase','apartment'];
---
<BaseLayout title="Commercial Locksmith Hollywood | Daniel's Lock & Key" description="Selected Hollywood commercial lockout, rekeying, storefront and office lock repair, and landlord support." canonical="/commercial/"><section class="page-hero"><div class="shell narrow"><p class="kicker">Selected small-business support</p><h1>Start with the authorized contact and affected opening.</h1><p class="lede">Daniel assesses supported Hollywood offices, storefronts, and rentals against the installed hardware and property requirements.</p><div class="actions"><a class="pill" href={`tel:${site.phoneHref}`}>Call Daniel · {site.phone}</a><a class="outline" href="/contact/">Plan service</a></div></div></section><section class="section shell"><div class="heading"><h2>Commercial help by request</h2><p>Specialized access control, exit devices, and proprietary systems are not implied.</p></div><div class="service-list">{commercialDetails.map((s,i)=><article data-reveal><i class={`fi fi-rr-${icons[i]} service-symbol`} aria-hidden="true"></i><div><p>{s.eyebrow}</p><h3>{s.title}</h3><p>{s.intro}</p></div><a href={`/${s.slug}/`}>Details →</a></article>)}</div></section></BaseLayout>
