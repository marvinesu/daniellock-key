---
import '../styles/global.css';import '../styles/architecture.css';import '../styles/call-first.css';import '../styles/production.css';import '../styles/gallery.css';import '../styles/locations.css';import ServiceGallery from '../components/ServiceGallery.astro';import SiteGrowth from '../components/SiteGrowth.astro';import AccessibilityMenu from '../components/AccessibilityMenu.astro';import SocialIcons from '../components/SocialIcons.astro';import {site} from '../data/site';
const {title,description,canonical=Astro.url.pathname,schema=[]}=Astro.props;const normalizedTitle=String(title).replace(/Daniel's Lock & Key(?! Service)/g,site.name);const releaseOrigin=import.meta.env.PUBLIC_SITE_URL||site.domain;const canonicalUrl=new URL(canonical,releaseOrigin).toString();
const graph={"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":`${site.domain}/#organization`,name:site.name,url:site.domain,telephone:site.phoneHref,areaServed:site.areas.map(name=>({"@type":"City",name}))},{"@type":"WebSite",name:site.name,url:site.domain,publisher:{"@id":`${site.domain}/#organization`}},...schema]};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{normalizedTitle}</title><meta name="description" content={description}><link rel="canonical" href={canonicalUrl}><meta name="theme-color" content="#00296b"><meta property="og:type" content="website"><meta property="og:title" content={normalizedTitle}><meta property="og:description" content={description}><meta property="og:url" content={canonicalUrl}><script is:inline type="application/ld+json" set:html={JSON.stringify(graph)}></script>
    <script is:inline>
      (() => {
        try {
          const state = JSON.parse(localStorage.getItem('a11y-preferences') || '{}');
          const classes = {
            largeText: 'a11y-large-text',
            highContrast: 'a11y-high-contrast',
            readableFont: 'a11y-readable-font',
            highlightLinks: 'a11y-highlight-links',
            reduceMotion: 'a11y-reduce-motion'
          };
          Object.entries(classes).forEach(([key, className]) =>
            document.documentElement.classList.toggle(className, state?.[key] === true)
          );
        } catch {}
      })();
    </script>
</head>
<body><a class="skip" href="#main">Skip to content</a><div class="progress" aria-hidden="true"><i data-progress></i></div>
<header><div class="notice"><div class="shell"><strong>Need a locksmith in Hollywood?</strong><a href={`tel:${site.phoneHref}`}>Call Daniel {site.phone}</a><span>Owner-operated service</span></div></div><div class="shell nav"><a class="brand" href="/" aria-label={`${site.name} home`}><img class="brand-logo" src="/images/logo-original.png" width="512" height="512" alt="Daniel's Lock & Key Service logo"></a><button class="menu" type="button" aria-expanded="false" aria-controls="nav">Menu</button><nav id="nav"><a href="/all-services/">Services</a><a href="/residential/">Residential</a><a href="/commercial/">Commercial</a><a href="/service-areas/">Areas</a><a href="/resources/">Resources</a><a href="/about/">About</a><a href="/faq/">FAQ</a><a href="/contact/">Contact</a><a class="pill emergency-menu-call" href={`tel:${site.phoneHref}`} aria-label="Request Service"><span>Request Service</span></a></nav></div></header>
<main id="main"><slot/>{!Astro.url.pathname.startsWith('/locations/')&&<ServiceGallery active={Astro.url.pathname}/>}</main>{!['/privacy/','/404/'].includes(Astro.url.pathname)&&<SiteGrowth/>}
<footer><div class="shell footer-grid"><div><a class="brand inverse" href="/" aria-label={`${site.name} home`}><img class="brand-logo footer-logo" src="/images/logo-original.png" width="512" height="512" alt="Daniel's Lock & Key Service logo"></a><p>Owner-operated locksmith help for homes, rentals, selected businesses, and passenger-vehicle lockout entry in Hollywood and nearby communities.</p><SocialIcons items={site.socials}/></div><div><h2>Services</h2><a href="/all-services/">All services</a><a href="/residential/">Residential hub</a><a href="/commercial/">Commercial hub</a><a href="/car-lockout/">Car lockout</a><a href="/service-areas/">Service areas</a></div><div><h2>Company</h2><a href="/about/">About</a><a href="/guides/">Locksmith guides</a><a href="/faq/">FAQ</a><a href="/business-information/">Business information</a><a href={`tel:${site.phoneHref}`}>{site.phone}</a><a href="/contact/">Request scheduled service</a><p><strong>Mobile service-area business</strong><br>Hollywood and approved nearby Los Angeles neighborhoods.<br>{site.license}</p></div><div class="footer-map"><p class="footer-map-label">Google Business map</p><iframe title="Google Map for Daniel's Lock & Key Service" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d422878.5178079065!2d-118.37795195000001!3d34.101840949999996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8678d8d91696c383%3A0x8875ceccca924926!2sDaniel's%20Lock%20%26%20Key%20Service!5e0!3m2!1sen!2sus!4v1788553911873!5m2!1sen!2sus" width="400" height="300" loading="lazy" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div></div><div class="shell legal">© {new Date().getFullYear()} {site.name} · <a href="/privacy/">Privacy</a></div></footer>
<style is:global>.footer-map{min-width:0}.footer-map-label{margin:0 0 .6rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.footer-map iframe{display:block;width:min(400px,100%);height:300px;border:0;border-radius:14px}.footer-grid{grid-template-columns:1.05fr .7fr .85fr 1.25fr}@media(max-width:1100px){.footer-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:800px){.footer-grid{grid-template-columns:1fr}.footer-map iframe{width:100%;height:280px}}</style>
<a class="floating-call" href={`tel:${site.phoneHref}`} aria-label={`Call Daniel at ${site.phone}`}><span aria-hidden="true">☎</span><strong>{site.phone}</strong></a>
<script>
const menu=document.querySelector<HTMLButtonElement>('.menu'),nav=document.querySelector<HTMLElement>('#nav');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('open',!open)});
const progress=document.querySelector<HTMLElement>('[data-progress]');addEventListener('scroll',()=>{if(progress){const max=document.documentElement.scrollHeight-innerHeight;progress.style.transform=`scaleX(${max?scrollY/max:0})`}}, {passive:true});const reveals=document.querySelectorAll<HTMLElement>('[data-reveal]');if('IntersectionObserver'in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches){document.documentElement.classList.add('reveal-ready');const io=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');io.unobserve(entry.target)}}),{threshold:.12});reveals.forEach(el=>io.observe(el))}else reveals.forEach(el=>el.classList.add('visible'));
</script><AccessibilityMenu/></body></html>
