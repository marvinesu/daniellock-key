---
import '../styles/global.css';import '../styles/architecture.css';import '../styles/call-first.css';import '../styles/production.css';import '../styles/gallery.css';import '../styles/locations.css';import ServiceGallery from '../components/ServiceGallery.astro';import SiteGrowth from '../components/SiteGrowth.astro';import AccessibilityMenu from '../components/AccessibilityMenu.astro';import {site} from '../data/site';
const {title,description,canonical=Astro.url.pathname,schema=[]}=Astro.props;const releaseOrigin=import.meta.env.PUBLIC_SITE_URL||site.preview;const canonicalUrl=new URL(canonical,releaseOrigin).toString();
const graph={"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":`${site.domain}/#organization`,name:site.name,url:site.domain,telephone:site.phoneHref,areaServed:site.areas.map(name=>({"@type":"City",name}))},{"@type":"WebSite",name:site.name,url:site.domain,publisher:{"@id":`${site.domain}/#organization`}},...schema]};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title}</title><meta name="description" content={description}><link rel="canonical" href={canonicalUrl}><meta name="theme-color" content="#00296b"><meta property="og:type" content="website"><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:url" content={canonicalUrl}><script is:inline type="application/ld+json" set:html={JSON.stringify(graph)}></script>
    <script is:inline>
      (() => {
        try {
          const state = JSON.parse(localStorage.getItem('a11y-preferences') || '{}');
          const classes = {
            largeText: 'a11y-large-text',
            highContrast: 'a11y-high-contrast',
            readableFont: 'a11y-readable-font',
            highlightLinks: 'a11y-highlight-links',
            reduceMotion: 'a11y-reduce-motion'
          };
          Object.entries(classes).forEach(([key, className]) =>
            document.documentElement.classList.toggle(className, state?.[key] === true)
          );
        } catch {}
      })();
    </script>
</head>
<body><a class="skip" href="#main">Skip to content</a><div class="progress" aria-hidden="true"><i data-progress></i></div>
<header><div class="notice"><div class="shell"><strong>Need a locksmith in Hollywood?</strong><a href={`tel:${site.phoneHref}`}>Call Daniel {site.phone}</a><span>Owner-operated service</span></div></div><div class="shell nav"><a class="brand" href="/" aria-label={`${site.name} home`}><span>D</span><b>Daniel's<br>Lock & Key</b></a><button class="menu" type="button" aria-expanded="false" aria-controls="nav">Menu</button><nav id="nav"><a href="/all-services/">Services</a><a href="/residential/">Residential</a><a href="/commercial/">Commercial</a><a href="/service-areas/">Areas</a><a href="/resources/">Resources</a><a href="/about/">About</a><a href="/faq/">FAQ</a><a href="/contact/">Contact</a><a class="pill" href={`tel:${site.phoneHref}`}>Call Daniel</a></nav></div></header>
<main id="main"><slot/>{!Astro.url.pathname.startsWith('/locations/')&&<ServiceGallery active={Astro.url.pathname}/>}</main>{!['/privacy/','/404/'].includes(Astro.url.pathname)&&<SiteGrowth/>}
<footer><div class="shell footer-grid"><div><a class="brand inverse" href="/"><span>D</span><b>Daniel's<br>Lock & Key</b></a><p>Owner-operated locksmith help for homes, rentals, selected businesses, and passenger-vehicle lockout entry in Hollywood and nearby communities.</p><div class="social-links" aria-label="Social media">{site.socials.map(item=><a href={item.url} target="_blank" rel="noopener">{item.label}</a>)}</div></div><div><h2>Services</h2><a href="/all-services/">All services</a><a href="/residential/">Residential hub</a><a href="/commercial/">Commercial hub</a><a href="/car-lockout/">Car lockout</a></div><div><h2>Contact</h2><a href={`tel:${site.phoneHref}`}>{site.phone}</a><a href="/contact/">Request scheduled service</a><p><strong>Mobile service-area business</strong><br>Hollywood and approved nearby Los Angeles neighborhoods.<br>{site.license}</p></div></div><div class="shell legal">© {new Date().getFullYear()} {site.name} · <a href="/privacy/">Privacy</a></div></footer>
<a class="floating-call" href={`tel:${site.phoneHref}`} aria-label={`Call Daniel at ${site.phone}`}><span aria-hidden="true">☎</span><span><strong>Call Daniel Now</strong><small>{site.phone}</small></span></a>
<script>
const menu=document.querySelector<HTMLButtonElement>('.menu'),nav=document.querySelector<HTMLElement>('#nav');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('open',!open)});
const progress=document.querySelector<HTMLElement>('[data-progress]');addEventListener('scroll',()=>{if(progress){const max=document.documentElement.scrollHeight-innerHeight;progress.style.transform=`scaleX(${max?scrollY/max:0})`}}, {passive:true});const reveals=document.querySelectorAll<HTMLElement>('[data-reveal]');if('IntersectionObserver'in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches){document.documentElement.classList.add('reveal-ready');const io=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');io.unobserve(entry.target)}}),{threshold:.12});reveals.forEach(el=>io.observe(el))}else reveals.forEach(el=>el.classList.add('visible'));
</script><AccessibilityMenu/></body></html>
