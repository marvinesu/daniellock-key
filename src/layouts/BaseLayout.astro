---
import '../styles/global.css';import '../styles/icons.css';import '../styles/architecture.css';import {site} from '../data/site';
const {title,description,canonical=Astro.url.pathname,schema=[]}=Astro.props;const canonicalUrl=new URL(canonical,site.domain).toString();
const graph={"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":`${site.domain}/#organization`,name:site.name,url:site.domain,telephone:site.phoneHref,areaServed:site.areas.map(name=>({"@type":"City",name}))},{"@type":"WebSite",name:site.name,url:site.domain,publisher:{"@id":`${site.domain}/#organization`}},...schema]};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title}</title><meta name="description" content={description}><link rel="canonical" href={canonicalUrl}><meta name="theme-color" content="#15171a"><meta property="og:type" content="website"><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:url" content={canonicalUrl}><script is:inline type="application/ld+json" set:html={JSON.stringify(graph)}></script></head>
<body><a class="skip" href="#main">Skip to content</a><div class="progress" aria-hidden="true"><i data-progress></i></div>
<header><div class="notice"><div class="shell"><strong>Need a locksmith in Hollywood?</strong><a href={`tel:${site.phoneHref}`}>Call Daniel {site.phone}</a><span>Owner-operated service</span></div></div><div class="shell nav"><a class="brand" href="/" aria-label={`${site.name} home`}><span>D</span><b>Daniel's<br>Lock & Key</b></a><button class="menu" type="button" aria-expanded="false" aria-controls="nav">Menu</button><nav id="nav"><a href="/all-services/">Services</a><a href="/residential/">Residential</a><a href="/commercial/">Commercial</a><a href="/service-areas/">Areas</a><a href="/resources/">Resources</a><a href="/about/">About</a><a href="/faq/">FAQ</a><a href="/contact/">Contact</a><a class="pill" href={`tel:${site.phoneHref}`}>Call Daniel</a></nav></div></header>
<main id="main"><slot/></main>
<footer><div class="shell footer-grid"><div><a class="brand inverse" href="/"><span>D</span><b>Daniel's<br>Lock & Key</b></a><p>Owner-operated locksmith help for homes, rentals, selected businesses, and passenger-vehicle lockout entry in Hollywood and nearby communities.</p><p class="icon-credit"><a href="https://www.flaticon.com/uicons" target="_blank" rel="noopener">UIcons by Flaticon</a></p></div><div><h2>Services</h2><a href="/all-services/">All services</a><a href="/residential/">Residential hub</a><a href="/commercial/">Commercial hub</a><a href="/car-lockout/">Car lockout</a></div><div><h2>Contact</h2><a href={`tel:${site.phoneHref}`}>{site.phone}</a><a href="/contact/">Request scheduled service</a><p>Mobile service-area business<br>No public street address advertised<br>{site.license}</p></div></div><div class="shell legal">© {new Date().getFullYear()} {site.name} · <a href="/privacy/">Privacy</a></div></footer>
<div class="mobile-call"><a href={`tel:${site.phoneHref}`}>Call Daniel · {site.phone}</a></div>
<div class="assistant" data-assistant><button class="assistant-open" type="button" aria-label="Open locksmith assistant" aria-expanded="false" aria-controls="assistant-panel"><span aria-hidden="true">D</span><b>Ask Daniel's guide</b></button><aside id="assistant-panel" aria-label="Locksmith assistant" aria-hidden="true" inert><header><div><small>Daniel's service guide</small><strong>What do you need help with?</strong></div><button type="button" data-close aria-label="Close assistant">×</button></header><div class="chat"><p>Choose one option. If you are locked out now, calling is the best next step.</p><div data-options><button data-choice="home">Locked out of a home</button><button data-choice="car">Keys locked in a car</button><button data-choice="rekey">Need different keys</button><button data-choice="repair">Lock or door is not working</button></div><div data-reply hidden></div></div><a class="assistant-call" href={`tel:${site.phoneHref}`}>Call Daniel · {site.phone}</a></aside></div>
<script>
const menu=document.querySelector<HTMLButtonElement>('.menu'),nav=document.querySelector<HTMLElement>('#nav');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('open',!open)});
const root=document.querySelector<HTMLElement>('[data-assistant]'),opener=root?.querySelector<HTMLButtonElement>('.assistant-open'),panel=root?.querySelector<HTMLElement>('aside'),closer=root?.querySelector<HTMLButtonElement>('[data-close]');const setOpen=(value:boolean)=>{if(!opener||!panel)return;opener.setAttribute('aria-expanded',String(value));panel.setAttribute('aria-hidden',String(!value));panel.inert=!value;root?.classList.toggle('open',value);(value?closer:opener)?.focus()};opener?.addEventListener('click',()=>setOpen(true));closer?.addEventListener('click',()=>setOpen(false));addEventListener('keydown',e=>{if(e.key==='Escape')setOpen(false)});
const replies={home:['Call Daniel with the exact address.','Have ID and proof of authorized access ready.'],car:['Passenger-vehicle entry only.','Call with the location, year, make, and model. Replacement keys and fob programming are not offered.'],rekey:['List the affected locks.','Share the property type, number of openings, and who should retain access.'],repair:['Describe the symptom.','Tell Daniel whether the key sticks, the cylinder is loose, or the latch misses the strike.']};root?.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach(button=>button.addEventListener('click',()=>{const box=root.querySelector<HTMLElement>('[data-reply]'),options=root.querySelector<HTMLElement>('[data-options]'),answer=replies[button.dataset.choice as keyof typeof replies];if(!box||!options||!answer)return;options.hidden=true;box.hidden=false;box.innerHTML=`<small>You chose: ${button.textContent}</small><h3>${answer[0]}</h3><p>${answer[1]}</p><button type="button" data-reset>Start over</button>`;box.focus();box.querySelector('button')?.addEventListener('click',()=>{box.hidden=true;options.hidden=false})}));
const progress=document.querySelector<HTMLElement>('[data-progress]');addEventListener('scroll',()=>{if(progress){const max=document.documentElement.scrollHeight-innerHeight;progress.style.transform=`scaleX(${max?scrollY/max:0})`}}, {passive:true});const reveals=document.querySelectorAll<HTMLElement>('[data-reveal]');if('IntersectionObserver'in window&&!matchMedia('(prefers-reduced-motion: reduce)').matches){document.documentElement.classList.add('reveal-ready');const io=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');io.unobserve(entry.target)}}),{threshold:.12});reveals.forEach(el=>io.observe(el))}else reveals.forEach(el=>el.classList.add('visible'));
</script></body></html>
